    "#| label: grafico-acumulado\n",
    "#| echo: false\n",
    "\n",
    "# --- Gráfico acumulado con hitos ---\n",
    "if total_recaudado > 0:\n",
    "    fig = go.Figure()\n",
    "\n",
    "    fig.add_trace(\n",
    "        go.Scatter(\n",
    "            x=df[\"fecha\"],\n",
    "            y=df[\"acumulado\"],\n",
    "            mode=\"lines+markers\",\n",
    "            name=\"Acumulado\",\n",
    "            line=dict(color=\"#27ae60\", width=3, shape=\"hv\"),\n",
    "            marker=dict(size=8, color=\"#27ae60\"),\n",
    "            fill=\"tozeroy\",\n",
    "            fillcolor=\"rgba(39, 174, 96, 0.1)\",\n",
    "            hovertemplate=\"%{x|%d %b %Y}<br>Total acumulado: $%{y:,.0f}<extra></extra>\",\n",
    "        )\n",
    "    )\n",
    "\n",
    "    # Línea de referencia de la meta anual\n",
    "    fig.add_hline(\n",
    "        y=META_ANUAL_CLP,\n",
    "        line_dash=\"dot\",\n",
    "        line_color=\"#e74c3c\",\n",
    "        annotation_text=\"Meta anual\",\n",
    "        annotation_position=\"top left\",\n",
    "        annotation_font_color=\"#e74c3c\",\n",
    "    )\n",
    "\n",
    "    # Anotaciones de hitos\n",
    "    for fecha_hito, texto_hito in HITOS:\n",
    "        fig.add_vline(\n",
    "            x=pd.Timestamp(fecha_hito),\n",
    "            line_dash=\"dash\",\n",
    "            line_color=\"#7f8c8d\",\n",
    "            annotation_text=texto_hito,\n",
    "            annotation_position=\"top\",\n",
    "            annotation_textangle=-90,\n",
    "            annotation_font_size=10,\n",
    "        )\n",
    "\n",
    "    fig.update_layout(\n",
    "        title=dict(\n",
    "            text=f\"Total Histórico Recaudado: ${total_recaudado:,.0f}\",\n",
    "            x=0.5,\n",
    "            xanchor=\"center\",\n",
    "            font=dict(size=18)\n",
    "        ),\n",
    "        template=\"plotly_white\",\n",
    "        font_family=\"Inter\",\n",
    "        height=420,\n",
    "        autosize=True,\n",
    "        hovermode=\"x unified\",\n",
    "        yaxis=dict(\n",
    "            title=\"CLP ($)\",\n",
    "            tickformat=\",.0f\",\n",
    "            gridcolor=\"rgba(0,0,0,0.08)\",\n",
    "            zeroline=False,\n",
    "            rangemode=\"tozero\"\n",
    "        ),\n",
    "        xaxis=dict(\n",
    "            tickformat=\"%d %b %Y\",\n",
    "            showgrid=False\n",
    "        ),\n",
    "        margin=dict(l=70, r=40, t=80, b=50)\n",
    "    )\n",
    "\n",
    "    fig.show(config={'displayModeBar': False})\n",
    "else:\n",
    "    display(Markdown(\"_Aún no hay aportes registrados. ¡Sé el primero en contribuir!_\"))"
   ]
