    "#| label: setup-donaciones\n",
    "#| echo: false\n",
    "#| warning: false\n",
    "\n",
    "import pandas as pd\n",
    "import plotly.graph_objects as go\n",
    "from IPython.display import Markdown, display, HTML\n",
    "\n",
    "# ============================================================\n",
    "# CONFIGURACIÓN — edita estos valores según necesites\n",
    "# ============================================================\n",
    "META_ANUAL_CLP = 65000  # dominio + hosting estimado, ver tabla de costos arriba\n",
    "\n",
    "# Hitos para marcar en el gráfico acumulado: (fecha, texto)\n",
    "# Agrega aquí cuando ocurra un evento relevante (compra de dominio, etc.)\n",
    "HITOS = [\n",
    "    # (\"2026-07-01\", \"Compra de dominio .cl\"),\n",
    "    # (\"2026-08-01\", \"Contratación de hosting\"),\n",
    "]\n",
    "\n",
    "# URL de exportación directa a CSV de tu Google Sheet\n",
    "url_csv = \"https://docs.google.com/spreadsheets/d/13w-D7T8BiIAueFALpnZBLFEQxsDdTvjw0FCb4iqdeIc/export?format=csv&gid=0\"\n",
    "\n",
    "try:\n",
    "    df = pd.read_csv(url_csv)\n",
    "    df.columns = df.columns.str.strip()\n",
    "\n",
    "    if 'Unnamed: 0' in df.columns:\n",
    "        df = df.drop(columns=['Unnamed: 0'])\n",
    "\n",
    "    df = df.rename(columns={\n",
    "        \"Nombre\": \"nombre\",\n",
    "        \"Aporte\": \"monto\",\n",
    "        \"Fecha\": \"fecha\",\n",
    "        \"Mensaje\": \"mensaje\"\n",
    "    })\n",
    "\n",
    "    if \"mensaje\" not in df.columns:\n",
    "        df[\"mensaje\"] = \"\"\n",
    "\n",
    "    df[\"monto\"] = df[\"monto\"].astype(str).str.replace(\",\", \"\").str.replace(\"$\", \"\").astype(float)\n",
    "    df[\"fecha\"] = pd.to_datetime(df[\"fecha\"], format=\"%d/%m/%Y\")\n",
    "    df = df.sort_values(\"fecha\")\n",
    "\n",
    "except Exception as e:\n",
    "    display(Markdown(f\"**Error al cargar datos:** `{e}`\"))\n",
    "    df = pd.DataFrame({\"fecha\": [], \"nombre\": [], \"monto\": [], \"mensaje\": []})\n",
    "\n",
    "if not df.empty:\n",
    "    df[\"acumulado\"] = df[\"monto\"].cumsum()\n",
    "    total_recaudado = df[\"monto\"].sum()\n",
    "    n_aportantes = df[\"nombre\"].nunique()\n",
    "    promedio_aporte = df[\"monto\"].mean()\n",
    "    dias_ultimo_aporte = (pd.Timestamp.today().normalize() - df[\"fecha\"].max()).days\n",
    "else:\n",
    "    total_recaudado = 0\n",
    "    n_aportantes = 0\n",
    "    promedio_aporte = 0\n",
    "    dias_ultimo_aporte = None"
   ]
  },
