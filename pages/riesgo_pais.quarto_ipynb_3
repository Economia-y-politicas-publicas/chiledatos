    "#| echo: false\n",
    "\n",
    "\n",
    "# --- Gráfico 2: Comparación todos los países ---\n",
    "if not df_embi.empty:\n",
    "    paises_todos = [c for c in df_embi.columns if c != \"fecha\"]\n",
    "\n",
    "    # Paleta de alto contraste, colores bien diferenciados\n",
    "    paleta = {\n",
    "        \"Global\":       \"#1f77b4\",\n",
    "        \"LATINO\":       \"#ff7f0e\",\n",
    "        \"REP DOM\":      \"#2ca02c\",\n",
    "        \"Argentina\":    \"#27d3d6\",\n",
    "        \"Bolivia\":      \"#9467bd\",\n",
    "        \"Brasil\":       \"#8c564b\",\n",
    "        \"Chile\":        \"#e377c2\",\n",
    "        \"Colombia\":     \"#7f7f7f\",\n",
    "        \"Costa Rica\":   \"#bcbd22\",\n",
    "        \"Ecuador\":      \"#cfc917\",\n",
    "        \"El Salvador\":  \"#aec7e8\",\n",
    "        \"Guatemala\":    \"#ffbb78\",\n",
    "        \"Honduras\":     \"#98df8a\",\n",
    "        \"México\":       \"#ff9896\",\n",
    "        \"Paraguay\":     \"#c5b0d5\",\n",
    "        \"Perú\":         \"#c49c94\",\n",
    "        \"Panamá\":       \"#f7b6d2\",\n",
    "        \"Uruguay\":      \"#dbdb8d\",\n",
    "        \"Venezuela\":    \"#c7c7c7\",  # gris — oculto por defecto\n",
    "        \"RD-LATINO\":    \"#9edae5\",\n",
    "    }\n",
    "\n",
    "    # Países que se ocultan por defecto por distorsionar la escala\n",
    "    ocultos = {\"Venezuela\", \"RD-LATINO\", \"Honduras\", \"Guatemala\", \"Bolivia\", \"Costa Rica\", \"El Salvador\", \"Paraguay\", \"Perú\", \"Panamá\",\"Uruguay\" }\n",
    "\n",
    "    fig2 = go.Figure()\n",
    "\n",
    "    for pais in paises_todos:\n",
    "        serie = df_embi[[\"fecha\", pais]].dropna()\n",
    "        if not serie.empty:\n",
    "            fig2.add_trace(\n",
    "                go.Scatter(\n",
    "                    x=serie[\"fecha\"],\n",
    "                    y=serie[pais],\n",
    "                    mode=\"lines\",\n",
    "                    name=pais,\n",
    "                    visible=\"legendonly\" if pais in ocultos else True,\n",
    "                    line=dict(\n",
    "                        color=paleta.get(pais, \"#333333\"),\n",
    "                        width=2.5\n",
    "                    ),\n",
    "                    hovertemplate=f\"<b>%{{x|%d %b %Y}}</b><br>{pais}: %{{y:.2f}}%<extra></extra>\",\n",
    "                )\n",
    "            )\n",
    "\n",
    "    fig2.update_layout(\n",
    "        title=dict(\n",
    "            text=\"Comparación EMBI — Todos los Países\",\n",
    "            x=0.5,\n",
    "            xanchor=\"center\",\n",
    "            font=dict(size=18),\n",
    "            y=0.9           # título bien arriba\n",
    "        ),\n",
    "        template=\"plotly_white\",\n",
    "        font_family=\"Inter\",\n",
    "        height=560,\n",
    "        autosize=True,\n",
    "        hovermode=\"x unified\",\n",
    "        legend=dict(\n",
    "            orientation=\"h\",\n",
    "            yanchor=\"top\",\n",
    "            y=-1,         # leyenda debajo del gráfico\n",
    "            xanchor=\"center\",\n",
    "            x=0.5,\n",
    "            font=dict(size=11)\n",
    "        ),\n",
    "        yaxis=dict(\n",
    "            title=\"Spread (%)\",\n",
    "            tickformat=\".2f\",\n",
    "            gridcolor=\"rgba(0,0,0,0.08)\",\n",
    "            zeroline=False,\n",
    "            rangemode=\"tozero\"\n",
    "        ),\n",
    "        xaxis=dict(\n",
    "            tickformat=\"%b %Y\",\n",
    "            showgrid=False,\n",
    "            rangeslider=dict(visible=True)\n",
    "        ),\n",
    "        margin=dict(l=70, r=40, t=120, b=120)  # más espacio abajo para leyenda\n",
    "    )\n",
    "\n",
    "    fig2.show(config={\"displayModeBar\": True})"
   ]
