    "#| label: setup\n",
    "#| include: false\n",
    "\n",
    "import os\n",
    "import requests\n",
    "import pandas as pd\n",
    "import plotly.express as px\n",
    "import plotly.graph_objects as go\n",
    "from datetime import datetime, timedelta\n",
    "\n",
    "# ── Datos CSV (deuda pública) ──────────────────────────────────────────────────\n",
    "url = \"https://raw.githubusercontent.com/Economia-y-politicas-publicas/chiledatos/main/data/finanzas_publicas.csv\"\n",
    "\n",
    "df = pd.read_csv(url, sep=\",\", encoding=\"utf-8\")\n",
    "df.columns = [\n",
    "    \"periodo\", \"deuda_bruta_gc\", \"deuda_neta_gc\",\n",
    "    \"deuda_bruta_bc\", \"deuda_neta_bc\",\n",
    "    \"deuda_bruta_sp\", \"deuda_neta_sp\",\n",
    "    \"deuda_bruta_ep\", \"deuda_neta_ep\",\n",
    "]\n",
    "cols_numericas = [\n",
    "    \"deuda_bruta_gc\", \"deuda_neta_gc\",\n",
    "    \"deuda_bruta_bc\", \"deuda_neta_bc\",\n",
    "    \"deuda_bruta_sp\", \"deuda_neta_sp\",\n",
    "    \"deuda_bruta_ep\", \"deuda_neta_ep\",\n",
    "]\n",
    "df[cols_numericas] = df[cols_numericas].apply(pd.to_numeric, errors=\"coerce\")\n",
    "df[\"fecha\"] = pd.to_datetime(df[\"periodo\"], format=\"%b.%Y\", errors=\"coerce\")\n",
    "df = df.dropna(subset=[\"fecha\"]).sort_values(\"fecha\")\n",
    "\n",
    "# ── API Banco Central (fondos soberanos) ───────────────────────────────────────\n",
    "usuario  = os.environ.get(\"BCENTRAL_USER\")\n",
    "password = os.environ.get(\"BCENTRAL_PASS\")\n",
    "URL_API  = \"https://si3.bcentral.cl/SieteRestWS/SieteRestWS.ashx\"\n",
    "\n",
    "def obtener_serie(codigo, dias=1095):\n",
    "    hoy    = datetime.today()\n",
    "    inicio = (hoy - timedelta(days=dias)).strftime(\"%Y-%m-%d\")\n",
    "    fin    = hoy.strftime(\"%Y-%m-%d\")\n",
    "    params = {\n",
    "        \"user\": usuario, \"pass\": password,\n",
    "        \"function\": \"GetSeries\", \"timeseries\": codigo,\n",
    "        \"firstdate\": inicio, \"lastdate\": fin, \"format\": \"json\",\n",
    "    }\n",
    "    try:\n",
    "        r    = requests.get(URL_API, params=params, timeout=10)\n",
    "        data = r.json()\n",
    "        obs  = data[\"Series\"][\"Obs\"]\n",
    "        df_  = pd.DataFrame(obs)\n",
    "        col_fecha = \"indexDateString\" if \"indexDateString\" in df_.columns else df_.columns[0]\n",
    "        col_valor = \"value\" if \"value\" in df_.columns else df_.columns[1]\n",
    "        df_[\"fecha\"] = pd.to_datetime(df_[col_fecha], format=\"%d-%m-%Y\", errors=\"coerce\")\n",
    "        df_[\"valor\"] = pd.to_numeric(df_[col_valor], errors=\"coerce\")\n",
    "        return df_.dropna(subset=[\"valor\"]).sort_values(\"fecha\").reset_index(drop=True)\n",
    "    except Exception as e:\n",
    "        print(f\"Error cargando {codigo}: {e}\")\n",
    "        return pd.DataFrame(columns=[\"fecha\", \"valor\"])\n",
    "\n",
    "AUTOR = \"Autor: Juan Miguieles Onetto | Fuente: Banco Central de Chile\"\n",
    "EJE_X = dict(dtick=\"M6\", tickformat=\"%b %Y\", tickangle=45, tickfont=dict(size=10))\n",
    "\n",
    "# ── Estilo unificado (basado en el gráfico \"Sector Público Consolidado\") ───────\n",
    "# En vez de leyenda: etiqueta de texto al final de cada línea.\n",
    "# Título centrado con el último dato como subtítulo. hovermode unificado.\n",
    "# Grid sutil solo en el eje Y. Anotación de autor siempre en la misma posición.\n",
    "\n",
    "def _agregar_autor(fig):\n",
    "    fig.add_annotation(\n",
    "        text=AUTOR, x=0, y=-0.22, xref=\"paper\", yref=\"paper\",\n",
    "        showarrow=False, font=dict(size=10, color=\"gray\"), xanchor=\"left\",\n",
    "    )\n",
    "    return fig\n",
    "\n",
    "def grafico_deuda(df_, col_bruta, col_neta, entidad):\n",
    "    \"\"\"Gráfico de deuda bruta/neta (% del PIB) para una entidad del sector público.\"\"\"\n",
    "    ultimo_bruto = df_[col_bruta].iloc[-1]\n",
    "    ultimo_neto  = df_[col_neta].iloc[-1]\n",
    "\n",
    "    fig = go.Figure()\n",
    "    fig.add_trace(go.Scatter(\n",
    "        x=df_[\"fecha\"], y=df_[col_bruta],\n",
    "        name=\"Deuda bruta\",\n",
    "        line=dict(color=\"#E74C3C\", width=3),\n",
    "        fill=\"tozeroy\",\n",
    "        fillcolor=\"rgba(231,76,60,0.08)\",\n",
    "        hovertemplate=\"%{x|%b %Y}<br><b>Deuda bruta:</b> %{y:.1f}%<extra></extra>\",\n",
    "    ))\n",
    "    fig.add_trace(go.Scatter(\n",
    "        x=df_[\"fecha\"], y=df_[col_neta],\n",
    "        name=\"Deuda neta\",\n",
    "        line=dict(color=\"#1F77B4\", width=3, dash=\"dash\"),\n",
    "        hovertemplate=\"%{x|%b %Y}<br><b>Deuda neta:</b> %{y:.1f}%<extra></extra>\",\n",
    "    ))\n",
    "    fig.add_hline(y=0, line_dash=\"dot\", line_color=\"gray\", opacity=0.5)\n",
    "\n",
    "    fig.add_annotation(x=df_[\"fecha\"].iloc[-1], y=df_[col_bruta].iloc[-1],\n",
    "        text=\"Deuda bruta\", showarrow=False, font=dict(size=11, color=\"#E74C3C\"), xshift=35)\n",
    "    fig.add_annotation(x=df_[\"fecha\"].iloc[-1], y=df_[col_neta].iloc[-1],\n",
    "        text=\"Deuda neta\", showarrow=False, font=dict(size=11, color=\"#1F77B4\"), xshift=35)\n",
    "\n",
    "    fig.update_layout(\n",
    "        title=dict(\n",
    "            text=(\n",
    "                f\"{entidad}: deuda bruta y neta (% del PIB)\"\n",
    "                f\"<br><sup>Último dato: Bruta {ultimo_bruto:.1f}% | Neta {ultimo_neto:.1f}%</sup>\"\n",
    "            ),\n",
    "            x=0.5, xanchor=\"center\", font=dict(size=18),\n",
    "        ),\n",
    "        template=\"plotly_white\",\n",
    "        font_family=\"Inter\",\n",
    "        height=560,\n",
    "        hovermode=\"x unified\",\n",
    "        yaxis=dict(title=\"% del PIB\", tickformat=\".0f\", gridcolor=\"rgba(0,0,0,0.08)\", zeroline=False),\n",
    "        xaxis=dict(\n",
    "            dtick=\"M12\", tickformat=\"%Y\", tickangle=45, showgrid=False,\n",
    "            rangeslider=dict(visible=True, thickness=0.025),\n",
    "        ),\n",
    "        showlegend=False,\n",
    "        margin=dict(l=70, r=90, t=90, b=90),\n",
    "    )\n",
    "    _agregar_autor(fig)\n",
    "    return fig\n",
    "\n",
    "def grafico_linea(df_, titulo, ytitle, color, formato_y=\",.0f\", prefijo=\"\", sufijo=\"\"):\n",
    "    \"\"\"Gráfico de una sola serie (fondos soberanos, activos del tesoro, etc.).\"\"\"\n",
    "    if df_.empty:\n",
    "        return go.Figure()\n",
    "\n",
    "    ultimo = df_[\"valor\"].iloc[-1]\n",
    "    fecha  = df_[\"fecha\"].iloc[-1].strftime(\"%d/%m/%Y\")\n",
    "\n",
    "    fig = go.Figure()\n",
    "    fig.add_trace(go.Scatter(\n",
    "        x=df_[\"fecha\"], y=df_[\"valor\"],\n",
    "        mode=\"lines\",\n",
    "        line=dict(color=color, width=3),\n",
    "        fill=\"tozeroy\",\n",
    "        fillcolor=color.replace(\")\", \",0.08)\").replace(\"rgb\", \"rgba\"),\n",
    "        hovertemplate=f\"%{{x|%b %Y}}<br><b>{titulo}:</b> {prefijo}%{{y:{formato_y}}}{sufijo}<extra></extra>\",\n",
    "    ))\n",
    "    fig.add_annotation(\n",
    "        x=df_[\"fecha\"].iloc[-1], y=df_[\"valor\"].iloc[-1],\n",
    "        text=titulo, showarrow=False, font=dict(size=11, color=color), xshift=35, xanchor=\"left\",\n",
    "    )\n",
    "    fig.update_layout(\n",
    "        title=dict(\n",
    "            text=f\"{titulo}<br><sup>Último dato: {prefijo}{ultimo:{formato_y}}{sufijo} ({fecha})</sup>\",\n",
    "            x=0.5, xanchor=\"center\", font=dict(size=18),\n",
    "        ),\n",
    "        template=\"plotly_white\",\n",
    "        font_family=\"Inter\",\n",
    "        height=560,\n",
    "        hovermode=\"x unified\",\n",
    "        yaxis=dict(title=ytitle, tickformat=formato_y, tickprefix=prefijo,\n",
    "                    gridcolor=\"rgba(0,0,0,0.08)\", zeroline=False),\n",
    "        xaxis=dict(**EJE_X, showgrid=False, rangeslider=dict(visible=True, thickness=0.025)),\n",
    "        showlegend=False,\n",
    "        margin=dict(l=70, r=90, t=90, b=90),\n",
    "    )\n",
    "    _agregar_autor(fig)\n",
    "    return fig\n",
    "\n",
    "def grafico_multi(trazas, titulo, ytitle):\n",
    "    \"\"\"trazas = lista de (df, nombre, color, ancho, dash). Etiquetas al final reemplazan la leyenda.\"\"\"\n",
    "    fig = go.Figure()\n",
    "    for df_, nombre, color, ancho, dash in trazas:\n",
    "        if df_.empty:\n",
    "            continue\n",
    "        fig.add_trace(go.Scatter(\n",
    "            x=df_[\"fecha\"], y=df_[\"valor\"],\n",
    "            name=nombre,\n",
    "            mode=\"lines\",\n",
    "            line=dict(color=color, width=ancho, dash=dash),\n",
    "            hovertemplate=f\"<b>{nombre}</b><br>%{{x|%b %Y}}<br>${{%{{y:,.0f}}}}M<extra></extra>\",\n",
    "        ))\n",
    "        fig.add_annotation(\n",
    "            x=df_[\"fecha\"].iloc[-1], y=df_[\"valor\"].iloc[-1],\n",
    "            text=nombre, showarrow=False, font=dict(size=11, color=color), xshift=35, xanchor=\"left\",\n",
    "        )\n",
    "    fig.update_layout(\n",
    "        title=dict(text=titulo, x=0.5, xanchor=\"center\", font=dict(size=18)),\n",
    "        yaxis=dict(title=ytitle, tickformat=\",.0f\", gridcolor=\"rgba(0,0,0,0.08)\", zeroline=False),\n",
    "        xaxis=dict(**EJE_X, showgrid=False, rangeslider=dict(visible=True, thickness=0.025)),\n",
    "        template=\"plotly_white\",\n",
    "        font_family=\"Inter\",\n",
    "        showlegend=False,\n",
    "        hovermode=\"x unified\",\n",
    "        height=560,\n",
    "        margin=dict(l=70, r=90, t=90, b=110),\n",
    "    )\n",
    "    _agregar_autor(fig)\n",
    "    return fig\n",
    "\n",
    "# Cargar series fondos soberanos\n",
    "fondossoberanos      = obtener_serie(\"F051.C19.STO.C.Z.USD.M\")\n",
    "fees                 = obtener_serie(\"F051.C17.STO.C.Z.USD.M\")\n",
    "frp                  = obtener_serie(\"F051.C15.STO.C.Z.USD.M\")\n",
    "oatp                 = obtener_serie(\"F051.M2.STO.C.Z.USD.M\")\n",
    "pesos                = obtener_serie(\"F051.M21.STO.C.Z.USD.M\")\n",
    "dolar                = obtener_serie(\"F051.M22.STO.C.Z.USD.M\")\n",
    "fondoeduc            = obtener_serie(\"F051.C181.STO.C.Z.USD.M\")\n",
    "fapr                 = obtener_serie(\"F051.M11.STO.C.Z.USD.M\")\n",
    "tratamientoaltocosto = obtener_serie(\"F051.M12.STO.C.Z.USD.M\")\n",
    "\n",
    "# Cargar series municipales operaciones NO financieras\n",
    "ingresos = obtener_serie(\"F051.AT01.FLU.M.D.CLP.T\")\n",
    "ingresos_tributarios_netos = obtener_serie(\"F051.AT011.FLU.M.D.CLP.T\")\n",
    "cobre_bruto = obtener_serie(\"F051.AT012.FLU.M.D.CLP.T\")\n",
    "imposiciones_previsionales = obtener_serie(\"F051.AT013.FLU.M.D.CLP.T\")\n",
    "donaciones = obtener_serie(\"F051.AT014.FLU.M.D.CLP.T\")\n",
    "rentas_de_la_propiedad = obtener_serie(\"F051.AT015.FLU.M.D.CLP.T\")\n",
    "ingresos_de_operacion = obtener_serie(\"F051.AT016.FLU.M.D.CLP.T\")\n",
    "otros_ingresos = obtener_serie(\"F051.AT017.FLU.M.D.CLP.T\")\n",
    "\n",
    "gastos = obtener_serie(\"F051.AT02.FLU.M.D.CLP.T\")\n",
    "personal = obtener_serie(\"F051.AT021.FLU.M.D.CLP.T\")\n",
    "bienes_y_servicios_de_consumo_y_produccion = obtener_serie(\"F051.AT022.FLU.M.D.CLP.T\")\n",
    "intereses = obtener_serie(\"F051.AT023.FLU.M.D.CLP.T\")\n",
    "subsidios_y_donaciones = obtener_serie(\"F051.AT024.FLU.M.D.CLP.T\")\n",
    "prestaciones_previsionales = obtener_serie(\"F051.AT025.FLU.M.D.CLP.T\")\n",
    "otros = obtener_serie(\"F051.AT026.FLU.M.D.CLP.T\")\n",
    "\n",
    "resultado_operativo_bruto = obtener_serie(\"F051.AT03.FLU.M.D.CLP.T\")\n",
    "\n",
    "adquisicion_neta_de_activos_no_financieros = obtener_serie(\"F051.BT01.FLU.M.D.CLP.T\")\n",
    "venta_de_activos_fisicos = obtener_serie(\"F051.BT011.FLU.M.D.CLP.T\")\n",
    "inversion = obtener_serie(\"F051.BT012.FLU.M.D.CLP.T\")\n",
    "transferencias_de_capital = obtener_serie(\"F051.BT013.FLU.M.D.CLP.T\")\n",
    "consumo_capital_fijo = obtener_serie(\"F051.BT014.FLU.M.D.CLP.T\")\n",
